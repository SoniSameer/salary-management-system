# Copy to .env and fill in. Never commit .env.
#
# Neon (https://neon.tech): open your project, choose "Connect", and copy the two
# connection strings. Keep Neon's default `sslmode=require`.
#
# You may see a warning about "SSL modes" when the app starts. It is harmless: the
# `pg` driver already treats `require` as a full certificate check, and the warning
# only announces that this wording will change in a future version.

# --- Needed by the running app (and the only variable Vercel needs) -------------
# The POOLED connection string: the host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"

# --- Needed only on your machine, to run migrations (`npm run db:migrate`) -------
# The DIRECT connection string: same as above without "-pooler".
# Not needed on Vercel: `prisma generate` works without it.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Needed only to run the integration tests (`npm run test:integration`) ------
# A SEPARATE database or Neon branch. The tests empty its tables, so the runner
# refuses to start if this is the same as DATABASE_URL or DIRECT_URL.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/TESTDB?sslmode=require"
