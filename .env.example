# Copy to .env and fill in. Never commit .env.

# Runtime connection (Neon pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"

# Direct connection, used by Prisma migrations (Neon non-pooled string)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Separate database or Neon branch used only by integration tests
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/TESTDB?sslmode=require"
